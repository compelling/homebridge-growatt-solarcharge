{
  "name": "homebridge-inverter-solarcharge",
  "displayName": "Platform: Inverter SolarCharge",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Homebridge plugin for inverters to upload data to SolarCharge",
  "author": "Compelling",
  "license": "Apache-2.0",
  "homepage": "https://github.com/compelling/homebridge-inverter-solarcharge#readme",
